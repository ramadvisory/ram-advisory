---
import ConstellationBg from "./ConstellationBg.astro";

interface Props {
  quote: string;
  heading?: string;
  body?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  quote,
  heading,
  body,
  buttonLabel = "Start a Conversation",
  buttonHref = "/contact/",
} = Astro.props;
---

<section class="relative overflow-hidden bg-deep-navy py-20">
  <ConstellationBg variant="dark" />
  <div class="relative mx-auto max-w-4xl px-6 text-center lg:px-8">
    <p class="font-display text-2xl italic text-white sm:text-3xl">{quote}</p>

    {heading && (
      <h2 class="mt-8 font-display text-3xl font-bold text-white">{heading}</h2>
    )}
    {body && <p class="mx-auto mt-4 max-w-xl font-sans text-base text-light-steel">{body}</p>}

    <a
      href={buttonHref}
      class="mt-10 inline-flex items-center gap-2 rounded-sm bg-white px-8 py-3.5 font-sans text-sm font-semibold uppercase tracking-wider text-heading-navy transition-colors hover:bg-pale-accent"
    >
      {buttonLabel}
    </a>
  </div>
</section>
