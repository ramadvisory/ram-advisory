---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConstellationBg from "../../components/ConstellationBg.astro";
import Kicker from "../../components/Kicker.astro";
---

<BaseLayout
  title="Contact"
  description="A confidential conversation costs nothing and commits you to nothing. Call, email, or send a message to start a conversation with RAM Advisory Group."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-deep-navy py-24 sm:py-28">
    <ConstellationBg variant="dark" />
    <div class="relative mx-auto max-w-4xl px-6 text-center lg:px-8">
      <p class="kicker text-light-steel">Let's Start a Conversation</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">
        You don't need to have all the answers before you call. You just need the question.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl font-sans text-base text-light-steel sm:text-lg">
        A confidential conversation costs nothing and commits you to nothing — it's the fastest way to
        find out whether RAM can help.
      </p>
      <p class="mx-auto mt-4 max-w-2xl font-sans text-sm italic text-light-steel">
        Every engagement is scoped and agreed as a fixed fee before any work begins — so you know the
        cost upfront, with no surprises later.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-5 lg:gap-20">
      <!-- Contact details -->
      <div class="lg:col-span-2">
        <Kicker>Get In Touch</Kicker>
        <div class="mt-6 space-y-6">
          <a href="tel:+447919365173" class="block">
            <p class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">Call</p>
            <p class="mt-1 font-display text-2xl font-bold text-heading-navy">07919 365173</p>
          </a>
          <a href="mailto:contact@ramadvisorygroup.co.uk" class="block">
            <p class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">Email</p>
            <p class="mt-1 font-display text-xl font-bold text-heading-navy break-words">
              contact@ramadvisorygroup.co.uk
            </p>
          </a>
          <div>
            <p class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">Web</p>
            <p class="mt-1 font-display text-xl font-bold text-heading-navy">www.ramadvisorygroup.co.uk</p>
          </div>
        </div>

        <div class="mt-12 border-t border-hairline pt-8">
          <p class="font-sans text-sm leading-relaxed text-ink">
            RAM works alongside your existing legal and accountancy advisers — adding the layer they
            don't provide, alongside the work they already do. Every enquiry is handled with
            discretion.
          </p>
          <p class="mt-6 font-display text-base font-bold text-heading-navy">Jonny Ramchurn</p>
          <p class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">Director</p>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3">
        <Kicker>Send a Message</Kicker>
        <form class="mt-6 space-y-6" method="POST">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="mt-2 w-full rounded-sm border border-hairline bg-white px-4 py-3 font-sans text-sm text-ink focus:border-heading-navy focus:outline-none"
              />
            </div>
            <div>
              <label for="company" class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">
                Organisation (optional)
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="mt-2 w-full rounded-sm border border-hairline bg-white px-4 py-3 font-sans text-sm text-ink focus:border-heading-navy focus:outline-none"
              />
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="email" class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="mt-2 w-full rounded-sm border border-hairline bg-white px-4 py-3 font-sans text-sm text-ink focus:border-heading-navy focus:outline-none"
              />
            </div>
            <div>
              <label for="phone" class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">
                Phone (optional)
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="mt-2 w-full rounded-sm border border-hairline bg-white px-4 py-3 font-sans text-sm text-ink focus:border-heading-navy focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="message" class="font-sans text-xs font-semibold uppercase tracking-wide text-steel">
              What's the situation?
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="mt-2 w-full rounded-sm border border-hairline bg-white px-4 py-3 font-sans text-sm text-ink focus:border-heading-navy focus:outline-none"
            ></textarea>
          </div>

          <p class="font-sans text-xs text-silver-grey">
            By submitting this form you agree to RAM Advisory Group contacting you about your enquiry.
            See our <a href="/privacy-policy/" class="underline hover:text-steel">Privacy Policy</a>.
          </p>

          <button
            type="submit"
            class="w-full rounded-sm bg-heading-navy px-8 py-3.5 text-center font-sans text-sm font-semibold uppercase tracking-wider text-white transition-colors hover:bg-deep-navy sm:w-auto"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
