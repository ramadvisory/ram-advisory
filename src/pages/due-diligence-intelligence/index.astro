import PillarPage from "../../components/PillarPage.astro";
---

<PillarPage
  metaTitle="Due Diligence & Intelligence"
  metaDescription="Genuine background research before you commit — senior appointments, suppliers, partnerships and transactions. Know before you commit."
  pillarNumber="02"
  icon="shield"
  eyebrow="Due Diligence & Intelligence"
  tagline="Know before you commit."
  situationParagraphs={[
    "A senior appointment. A new supplier. An investment that looks straightforward on paper. Once you've committed — signed, shaken hands, transferred the deposit — it's hard to walk back, which is exactly why the checking needs to happen before that point, not after.",
  ]}
  stats={[
    { stat: "£132,000", caption: "The average cost of a bad hire at mid-manager level in the UK, once recruitment, disruption and replacement are counted.", source: "REC (Recruitment & Employment Confederation), 2025/26" },
  ]}
  handledParagraph="It starts with understanding what's genuinely at stake — a senior appointment brings access and trust, potentially for years; a new supplier brings dependency. From there comes the real background work: genuine research into who this person or organisation is — including the eighteen-month CV gap a standard reference check would never explain. That gap gets looked at properly. It might be entirely innocent. The point is to find out, not to assume the worst."
  leftWithParagraph="Findings translate into a decision, not a verdict. Every finding leaves the same three options — accept it, mitigate it, or remove it from the deal — and knowing which one applies is exactly the clarity you're paying for. That's the basis for deciding with confidence, before the contract's signed. RAM works alongside your existing legal and accountancy advisers throughout — adding the intelligence layer they don't provide, alongside the work they already do."
  rightNow="A background picture built from real checking, before you've signed anything."
  beyondThat="A sharper instinct for what to check next time, and fewer decisions made on assumption."
  economicsParagraph="The check itself costs a fraction of that £132,000 figure. It won't guarantee the right outcome — nothing can — but it means whatever you decide, you're deciding with real information instead of hope."
  economicsSource="REC (Recruitment & Employment Confederation), 2025/26"
  bookItems={[
    "Senior Appointment Due Diligence",
    "Third-Party & Supplier Due Diligence",
    "Transaction & Partnership Due Diligence",
  ]}
  closingLine="Independent perspective. Confidence in your decision."
  otherPillars={[
    {
      href: "/investigations/",
      icon: "search",
      title: "Investigations",
      situation: "When you need to know what happened.",
    },
    {
      href: "/risk-resilience/",
      icon: "radar",
      title: "Risk & Resilience",
      situation: "When you'd rather find the gap than discover it.",
    },
  ]}
/>
