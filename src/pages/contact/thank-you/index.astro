---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ConstellationBg from "../../../components/ConstellationBg.astro";
---

<BaseLayout
  title="Thank You"
  description="Thanks for getting in touch with RAM Advisory Group. We'll be back to you shortly."
>
  <section class="relative overflow-hidden bg-deep-navy py-24 sm:py-28">
    <ConstellationBg variant="dark" />
    <div class="relative mx-auto max-w-3xl px-6 text-center lg:px-8">
      <p class="kicker text-light-steel">Message Sent</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Thank you for getting in touch.</h1>
      <p class="mx-auto mt-6 max-w-2xl font-sans text-base text-light-steel sm:text-lg">
        We've received your message and will come back to you shortly. If your enquiry is urgent, call
        07919 365173.
      </p>
      <a
        href="/"
        class="mt-10 inline-block rounded-sm bg-white px-8 py-3.5 text-center font-sans text-sm font-semibold uppercase tracking-wider text-heading-navy transition-colors hover:bg-light-steel"
      >
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>
