---
interface Props {
  quote: string;
  name: string;
  role: string;
  linkedin: string;
}

const { quote, name, role, linkedin } = Astro.props;
---

<figure class="flex h-full flex-col rounded-sm border border-hairline bg-white p-8">
  <span class="font-display text-4xl leading-none text-hairline">&ldquo;</span>
  <blockquote class="mt-2 flex-1 font-display text-base italic leading-relaxed text-heading-navy">
    {quote}
  </blockquote>
  <figcaption class="mt-6 border-t border-hairline pt-5">
    <p class="font-sans text-sm font-semibold text-heading-navy">{name}</p>
    <p class="font-sans text-xs text-steel">{role}</p>
    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 inline-flex items-center gap-1.5 font-sans text-xs font-semibold text-heading-navy underline decoration-heading-navy/30 underline-offset-2 hover:text-steel"
    >
      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        ></path>
      </svg>
      View on LinkedIn
    </a>
  </figcaption>
</figure>
