---
type IconName =
  | "compass"
  | "chat"
  | "scale"
  | "lock"
  | "target"
  | "hand"
  | "search"
  | "shield"
  | "radar"
  | "arrow-right";

interface Props {
  icon: IconName;
  class?: string;
  size?: "md" | "lg";
  dark?: boolean;
}

const { icon, class: className = "", size = "md", dark = false } = Astro.props;

const dims = size === "lg" ? "h-16 w-16" : "h-12 w-12";
const iconDims = size === "lg" ? "h-7 w-7" : "h-5 w-5";
const palette = dark
  ? "border-white/40 bg-transparent text-white"
  : "border-heading-navy bg-white text-heading-navy";
---

<span
  class={`inline-flex ${dims} shrink-0 items-center justify-center rounded-full border ${palette} ${className}`}
>
  <svg
    class={iconDims}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {icon === "compass" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M15.5 8.5 13 13l-4.5 2.5L11 11l4.5-2.5Z" />
      </>
    )}
    {icon === "chat" && (
      <path d="M4 5.5h16a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H9l-4 3v-3H4a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Z" />
    )}
    {icon === "scale" && (
      <>
        <path d="M12 3v18M8 21h8" />
        <path d="M5 7h14M5 7 3 12a2.5 2.5 0 0 0 5 0L6 7m13 0-2 5a2.5 2.5 0 0 0 5 0l-2-5" />
      </>
    )}
    {icon === "lock" && (
      <>
        <rect x="5" y="11" width="14" height="9" rx="1.5" />
        <path d="M8 11V7.5a4 4 0 1 1 8 0V11" />
      </>
    )}
    {icon === "target" && (
      <>
        <circle cx="12" cy="12" r="8" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="12" cy="12" r="0.6" fill="currentColor" />
      </>
    )}
    {icon === "hand" && (
      <path d="M8 12.5V6a1.5 1.5 0 0 1 3 0v5m0-4a1.5 1.5 0 0 1 3 0v4m0-2.5a1.5 1.5 0 0 1 3 0V13m0-1a1.5 1.5 0 0 1 3 0v4a6 6 0 0 1-6 6h-1a7 7 0 0 1-5.6-2.8L4 15.7a1.4 1.4 0 0 1 2.2-1.7L8 16" />
    )}
    {icon === "search" && (
      <>
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="m20 20-4.7-4.7" />
      </>
    )}
    {icon === "shield" && (
      <path d="M12 3.5 19 6.5v5.2c0 4.6-3 8.3-7 9.3-4-1-7-4.7-7-9.3V6.5Z" />
    )}
    {icon === "radar" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="5.2" />
        <path d="M12 12 18 8" />
      </>
    )}
    {icon === "arrow-right" && (
      <path d="M4 12h16m0 0-6-6m6 6-6 6" />
    )}
  </svg>
</span>
